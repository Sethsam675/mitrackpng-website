{
  "name": "mitrackpng-website",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Static site preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python scripts/validate_html.py && python scripts/check_links.py && python scripts/lint_css.py && python scripts/check_shared_markup.py",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "ecmel.vscode-html-css"
      ]
    }
  }
}
